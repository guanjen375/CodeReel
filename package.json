{
  "name": "codereel",
  "version": "0.1.0",
  "private": true,
  "description": "將程式碼儲存庫轉成繁體中文教學投影片、旁白、字幕與影片的 local-first 管線",
  "type": "module",
  "bin": {
    "codereel": "./src/cli.mjs"
  },
  "scripts": {
    "codereel": "node ./src/cli.mjs",
    "doctor": "node ./src/cli.mjs doctor --config ./codereel.config.json",
    "analyze": "node ./src/cli.mjs analyze --config ./codereel.config.json",
    "build": "node ./src/cli.mjs build --config ./codereel.config.json",
    "run": "node ./src/cli.mjs run --config ./codereel.config.json",
    "demo": "node ./src/cli.mjs run --config ./examples/demo.config.json --force",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "image-size": "file:./vendor/image-size-disabled",
    "jszip": "3.10.1",
    "pptxgenjs": "4.0.1"
  },
  "overrides": {
    "pptxgenjs": {
      "image-size": "$image-size"
    }
  }
}
